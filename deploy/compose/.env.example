# Copy to .env next to docker-compose.yml. NEVER commit the real file.
OPENROUTER_API_KEY=sk-or-v1-REPLACE_ME
OSIRIS_URL=http://host.docker.internal:3001
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=deepseek/deepseek-v4-pro

# Leave blank while the engine is loopback-only. Set BOTH of these together
# when you want to reach it from another machine:
#   PYTHIA_PUBLISH_ADDR = the Tailscale/LAN IP to bind to (never 0.0.0.0)
#   PYTHIA_API_TOKEN    = a long random string; every request must send
#                         Authorization: Bearer <token>
PYTHIA_PUBLISH_ADDR=127.0.0.1
PYTHIA_API_TOKEN=
CORS_ORIGINS=
