# ───────────────────── PYTHIA ORACLE CONFIG ─────────────────────
# Osiris world data -> local LLM -> predictions. No API keys, no cost.
# Copy to .env. Defaults work out of the box if Ollama + Osiris are running.

OSIRIS_URL=http://localhost:3000
ENGINE_HOST=0.0.0.0
ENGINE_PORT=8088

# ── Oracle brain ──
# Recommended (cloud, multi-model): OpenRouter. LLM_API_KEY may stay BLANK — the engine
# auto-reads OPENROUTER_API_KEY from ~/.hermes/.env. Any OpenAI-compatible API works.
LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_API_KEY=                          # blank -> auto-read from ~/.hermes/.env
LLM_MODEL=deepseek/deepseek-v4-pro
#
# ...or run fully local instead (needs Ollama on :11434):
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=ollama
# LLM_MODEL=llama3.1
#
# ...or leave ALL three blank to reuse MiroFish's model from ~/MiroFish/.env.
ORACLE_TEMPERATURE=0.5          # 0=cautious, 1=imaginative
ORACLE_TIMEOUT_SEC=180

# ── Swarm: one distinct model per persona -> genuinely decorrelated votes ──
# SWARM_BASE_URL / SWARM_API_KEY default to the oracle's above. Leave a persona blank
# to fall back to LLM_MODEL (== today's single-model behaviour). Four different labs:
SWARM_STRATEGIST_MODEL=anthropic/claude-sonnet-5
SWARM_ECONOMIST_MODEL=openai/gpt-5.4-mini   # gpt-5.5 is ~7x pricier; mini keeps cost low
SWARM_NATURALIST_MODEL=google/gemini-3.5-flash
SWARM_SKEPTIC_MODEL=deepseek/deepseek-v4-pro
# SWARM_ENABLED=true

# ── Predictions ──
HORIZONS=24h,week,month,year    # time horizons to forecast
PREDICTIONS_PER_HORIZON=3
LOOP_INTERVAL_SEC=1800          # auto-refresh cadence when the loop is ON (30 min)

# ── Calibration (LLM judge scores forecasts once their horizon expires) ──
# JUDGE_MODEL=                  # blank -> LLM_MODEL. Cheap model recommended.
RESOLVE_INTERVAL_SEC=1800       # how often to sweep for expired forecasts (no LLM call when none due)
