diff --git a/src/app/globals.css b/src/app/globals.css
index c880ea3..dc2c7d6 100644
--- a/src/app/globals.css
+++ b/src/app/globals.css
@@ -70,9 +70,12 @@
 
 /* 🔥
    THEME TRANSITION SYSTEM
+   Only animate during an actual theme switch (body.theme-switching is added
+   for ~700ms by the toggle) — a permanent `* { transition }` re-animates every
+   color/border change on every data tick, which janks a page this busy.
    🔥 */
-* {
-  transition: background-color 0.6s cubic-bezier(0.16, 1, 0.3, 1), 
+body.theme-switching * {
+  transition: background-color 0.6s cubic-bezier(0.16, 1, 0.3, 1),
               border-color 0.6s cubic-bezier(0.16, 1, 0.3, 1),
               color 0.6s cubic-bezier(0.16, 1, 0.3, 1),
               box-shadow 0.6s cubic-bezier(0.16, 1, 0.3, 1);
@@ -2247,3 +2250,64 @@ html, body {
     transition-duration: 0.01ms !important;
   }
 }
+
+/* ── PYTHIA overlay (fork) ── */
+:root { --font-doto: 'Doto', 'JetBrains Mono', ui-monospace, 'SF Mono', Menlo, monospace; }
+.pythia-display { font-family: var(--font-doto); font-weight: 700; letter-spacing: 0.06em; }
+@keyframes pythia-ticker-scroll { from { transform: translateX(0); } to { transform: translateX(-50%); } }
+.animate-ticker { animation-name: pythia-ticker-scroll; animation-timing-function: linear; animation-iteration-count: infinite; }
+
+/* Readability: the active Osiris theme uses low-contrast purples (--text-muted #4A148C,
+   --gold-primary/--cyan-primary purple). Scope brighter, legible values to PYTHIA UI only. */
+.pythia-scope {
+  --gold-primary: #cbb6ff;   /* was #B388FF — brighter violet */
+  --cyan-primary: #63e6ff;   /* was #7C4DFF purple — real cyan */
+  --alert-red:    #ff8a8a;   /* was #FF3D3D — softer, readable at small sizes */
+  --text-primary: #f4f0fb;
+  --text-secondary:#cdbff0;
+  --text-muted:   #a99fc6;   /* was #4A148C — near-invisible; now legible */
+  --text-heading: #f4f0fb;
+}
+
+/* ── PYTHIA light theme (fork) — Apple-white mode; toggled via body.theme-light ── */
+body.theme-light {
+  --gold-rgb: 107, 75, 214;
+  --cyan-rgb: 13, 143, 176;
+  --bg-void: #eef1f6;
+  --bg-primary: #f4f6fa;
+  --bg-secondary: #e9edf3;
+  --bg-tertiary: #dfe4ec;
+  --bg-panel: rgba(255, 255, 255, 0.82);
+  --bg-panel-solid: #ffffff;
+  /* text-bearing tokens are AA-computed vs #f4f6fa and #fff (≥4.5:1 small text) */
+  --gold-primary: #5f3ecc; --gold-light: #8a6cff; --gold-dim: #b7a6e8;
+  --cyan-primary: #0a6f8a; --cyan-dim: #7fd3e6;
+  --alert-red: #d02b2b; --alert-orange: #a85800; --alert-green: #10733d; --alert-blue: #2e6fd6;
+  --border-primary: rgba(60,50,90,0.14); --border-secondary: rgba(60,50,90,0.08); --border-active: rgba(107,75,214,0.4);
+  --text-primary: #1b1f2a; --text-secondary: #444b5a; --text-muted: #5b6472;
+  --text-heading: #14181f; --text-gold: #5f3ecc; --text-cyan: #0a6f8a;
+  --fw-shadow: 0 12px 40px rgba(40, 40, 80, 0.18);
+  --fw-header-bg: rgba(0, 0, 0, 0.04);
+  --hover-accent: rgba(60,50,90,0.06);
+  --scrollbar-thumb: rgba(60,50,90,0.25);
+}
+/* keep the PYTHIA overlay legible on white (its dark-mode scope uses light text) */
+body.theme-light .pythia-scope {
+  --gold-primary: #5f3ecc; --cyan-primary: #0a6f8a; --alert-red: #d02b2b; --alert-green: #10733d;
+  --text-primary: #1b1f2a; --text-secondary: #3f4656; --text-muted: #5b6472; --text-heading: #14181f;
+}
+
+/* ── light-mode readability fixes (fork) ──────────────────────────────────
+   1. Stock components hardcode dark-theme hexes; override by class substring
+      (higher specificity than the Tailwind arbitrary-value utility). */
+body.theme-light [class*="D4AF37"] { color: #7d631c; }               /* OSIRIS header gold, 5.28:1 */
+body.theme-light [class*="14F195"] {                                  /* $OSIRIS token green, 5.73:1 */
+  color: #096f4b; border-color: rgba(9, 111, 75, 0.4); background: rgba(9, 111, 75, 0.08);
+}
+/* 2. The bottom tickers keep their black chrome in light mode, so pin the
+      dark-theme text palette inside them (vars inherit down). */
+body.theme-light .pythia-ticker-bg,
+body.theme-light [class*="z-[198]"] {
+  --text-primary: #f4f0fb; --text-secondary: #cdbff0; --text-muted: #a99fc6;
+  --gold-primary: #8a6cff; --cyan-primary: #22b8dd; --alert-red: #ff8a8a; --alert-green: #2df5c8;
+}
